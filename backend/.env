# Flask Configuration
SECRET_KEY=medscan-super-secret-key-change-in-production
FLASK_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=medscan_auth

# JWT Configuration
JWT_SECRET_KEY=medscan-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=24

# MySQL Database Configuration (keeping for existing features)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=medical_analysis_system

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
HEATMAP_FOLDER=heatmaps
REPORTS_FOLDER=reports

# Model Configuration
MODEL_PATH=../ml/models/
BRAIN_TUMOR_MODEL_PATH=../ml/models/best_brain_tumor_model.pth
PNEUMONIA_MODEL_PATH=../ml/models/best_pnemonia_model.pth

# Security Configuration
BCRYPT_LOG_ROUNDS=12
SESSION_TIMEOUT=3600

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
